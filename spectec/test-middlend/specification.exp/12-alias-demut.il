;; ../../../../specification/wasm-3.0/1.3-syntax.instructions.spectec
def $const(consttype : consttype, lit_ : lit_) : instr
  ;; ../../../../specification/wasm-3.0/1.3-syntax.instructions.spectec
  def $const{c : num_}(I32_consttype, mk_lit__0_lit_(I32_numtype, c)) = CONST_instr(I32_numtype, c)
