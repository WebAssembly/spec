;; ../../../../specification/wasm-3.0/6.1-text.values.spectec
grammar Tsign : int
  ;; ../../../../specification/wasm-3.0/6.1-text.values.spectec
  prod eps => + (1 : nat <:> int)
  ;; ../../../../specification/wasm-3.0/6.1-text.values.spectec
  prod "+" => + (1 : nat <:> int)
  ;; ../../../../specification/wasm-3.0/6.1-text.values.spectec
  prod "-" => - (1 : nat <:> int)

;; ../../../../specification/wasm-3.0/6.1-text.values.spectec
