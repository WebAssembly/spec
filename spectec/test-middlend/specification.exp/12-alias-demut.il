    -- wf_instr: `%`(THROW_REF_instr,)
  ;; ../../../../specification/wasm-3.0/4.0-execution.configurations.spectec
  def $lift_result(TRAP_result) = [TRAP_instr]
    -- wf_instr: `%`(TRAP_instr,)

