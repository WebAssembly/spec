    -- Step: `%~>%`(`%;%`_config(z, instr*{instr <- `instr*`}), `%;%`_config(z', instr'*{instr' <- `instr'*`}))
    -- Steps: `%~>*%`(`%;%`_config(z', instr'*{instr' <- `instr'*`}), `%;%`_config(z'', instr''*{instr'' <- `instr''*`}))
    -- wf_config: `%`(`%;%`_config(z, instr*{instr <- `instr*`}),)
    -- wf_config: `%`(`%;%`_config(z'', instr''*{instr'' <- `instr''*`}),)
    -- wf_config: `%`(`%;%`_config(z', instr'*{instr' <- `instr'*`}),)
}

