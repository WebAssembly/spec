    -- if ($proj_sN_0(i).0 >= (0 : nat <:> int))

;; ../../../../specification/wasm-3.0/5.3-binary.instructions.spectec
grammar Bcatch : catch
  ;; ../../../../specification/wasm-3.0/5.3-binary.instructions.spectec
