    -- if ($ieee_(N, q) =/= INF_fNmag)
  ;; ../../../../specification/wasm-3.0/6.1-text.values.spectec
  prod "inf" => INF_fNmag
  ;; ../../../../specification/wasm-3.0/6.1-text.values.spectec
  prod "nan" => NAN_fNmag($canon_(N),)
  ;; ../../../../specification/wasm-3.0/6.1-text.values.spectec
  prod{n : n} {{"nan:0x"} {n:Thexnum}} => NAN_fNmag(n,)
    -- if ((1 <= n) /\ (n < (2 ^ !($signif(N)))))

;; ../../../../specification/wasm-3.0/6.1-text.values.spectec
