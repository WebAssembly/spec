  ;; ../../../../specification/wasm-3.0/2.4-validation.modules.spectec
  def $funcidx_nonfuncs{`global*` : global*, `mem*` : mem*, `table*` : table*, `elem*` : elem*, `export*` : export*}(`%%%%%`_nonfuncs(global#2*{global#2 <- `global*`}, mem#5*{mem#5 <- `mem*`}, table#5*{table#5 <- `table*`}, elem#5*{elem#5 <- `elem*`}, export#6*{export#6 <- `export*`})) = $funcidx_module(MODULE_module(`%`_list([],), `%`_list([],), `%`_list([],), `%`_list(global*{global <- `global*`},), `%`_list(mem*{mem <- `mem*`},), `%`_list(table*{table <- `table*`},), `%`_list([],), `%`_list([],), `%`_list(elem*{elem <- `elem*`},), ?(), `%`_list(export*{export <- `export*`},)))
