;; ../../../../specification/wasm-3.0/2.3-validation.instructions.spectec
def $is_packtype(storagetype : storagetype) : bool
  ;; ../../../../specification/wasm-3.0/2.3-validation.instructions.spectec
  def $is_packtype{zt : storagetype}(zt) = (zt =/= $storagetype_valtype($unpack(zt)))

